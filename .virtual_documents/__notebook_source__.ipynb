import random
from pathlib import Path

import numpy as np
import pandas as pd
import torch
from torch.utils.data import Dataset, DataLoader
from decord import VideoReader, cpu
import decord

decord.bridge.set_bridge('torch')


# =========================================================
# 1) Utility: detect path / label columns automatically
# =========================================================
def resolve_columns(df):
    path_col = next(c for c in df.columns if "path" in c.lower())
    label_col = next(c for c in df.columns if "label" in c.lower())
    return path_col, label_col


# =========================================================
# 2) Binary filtering helper
# =========================================================
def make_binary_split(train_df, val_df, test_df, label_col, binary_classes):
    """
    Keep only two classes from train/val/test dataframes.
    binary_classes: list like ["Basketball", "Diving"]
    """
    assert len(binary_classes) == 2, "binary_classes must contain exactly 2 class names"

    train_df = train_df[train_df[label_col].isin(binary_classes)].copy()
    val_df   = val_df[val_df[label_col].isin(binary_classes)].copy()
    test_df  = test_df[test_df[label_col].isin(binary_classes)].copy()

    class_to_idx = {
        binary_classes[0]: 0,
        binary_classes[1]: 1
    }
    idx_to_class = {0: binary_classes[0], 1: binary_classes[1]}

    return train_df, val_df, test_df, class_to_idx, idx_to_class


# =========================================================
# 3) Optional balancing helper
# =========================================================
def sample_per_class(df, label_col, n_per_class, seed=0):
    parts = []
    for _, g in df.groupby(label_col):
        parts.append(g.sample(min(len(g), n_per_class), random_state=seed))
    return pd.concat(parts, axis=0).reset_index(drop=True)

class UCF101BinaryVideoDataset(Dataset):
    def __init__(
        self,
        df,
        root_dir,
        path_col,
        label_col,
        class_to_idx,
        num_frames=16,
        frame_size=112,
        mode="train",
    ):
        """
        df: dataframe containing video paths and labels
        root_dir: root folder of dataset
        path_col: name of path column in csv
        label_col: name of label column in csv
        class_to_idx: dict, e.g. {"Basketball":0, "Diving":1}
        num_frames: number of frames sampled from each video
        frame_size: spatial size after crop/resize
        mode: 'train', 'val', or 'test'
        """
        self.df = df.reset_index(drop=True)
        self.root_dir = Path(root_dir)
        self.path_col = path_col
        self.label_col = label_col
        self.class_to_idx = class_to_idx
        self.num_frames = num_frames
        self.frame_size = frame_size
        self.mode = mode

        self.paths = self.df[path_col].tolist()
        self.labels = [self.class_to_idx[l] for l in self.df[label_col].tolist()]

        # ImageNet normalization
        self.mean = torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1)
        self.std  = torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1)

    def __len__(self):
        return len(self.paths)

    # -----------------------------------------------------
    # temporal sampling
    # -----------------------------------------------------
    def _sample_indices(self, total_frames):
        """
        Returns frame indices of length self.num_frames
        """
        if total_frames <= 0:
            return np.zeros(self.num_frames, dtype=int)

        # If video is shorter than desired number of frames
        if total_frames < self.num_frames:
            idx = np.linspace(0, total_frames - 1, total_frames).astype(int)
            pad = np.full(self.num_frames - total_frames, total_frames - 1, dtype=int)
            return np.concatenate([idx, pad])

        if self.mode == "train":
            # segment-based random sampling
            seg = total_frames / self.num_frames
            idx = [int(seg * i + random.random() * seg) for i in range(self.num_frames)]
            idx = np.array(idx, dtype=int)
        else:
            # deterministic uniform sampling for val/test
            idx = np.linspace(0, total_frames - 1, self.num_frames).astype(int)

        return np.clip(idx, 0, total_frames - 1)

    # -----------------------------------------------------
    # spatial augmentation params
    # -----------------------------------------------------
    def _spatial_params(self, h, w):
        short = min(h, w)
        scale = self.frame_size / short

        new_h = max(int(round(h * scale)), self.frame_size)
        new_w = max(int(round(w * scale)), self.frame_size)

        if self.mode == "train":
            top = random.randint(0, new_h - self.frame_size)
            left = random.randint(0, new_w - self.frame_size)
            flip = (random.random() < 0.5)
        else:
            top = (new_h - self.frame_size) // 2
            left = (new_w - self.frame_size) // 2
            flip = False

        return new_h, new_w, top, left, flip

    def __getitem__(self, idx):
        # -------------------------------------------------
        # path + label
        # -------------------------------------------------
        rel_path = str(self.paths[idx]).lstrip("/")
        video_path = self.root_dir / rel_path
        label = self.labels[idx]

        # -------------------------------------------------
        # read video
        # -------------------------------------------------
        vr = VideoReader(str(video_path), ctx=cpu(0))
        total_frames = len(vr)

        frame_idx = self._sample_indices(total_frames)
        frames = vr.get_batch(frame_idx)   # shape: (T, H, W, C), torch uint8

        # -------------------------------------------------
        # convert to float tensor in [0,1]
        # -------------------------------------------------
        # (T,H,W,C) -> (T,C,H,W)
        clip = frames.permute(0, 3, 1, 2).float() / 255.0

        T, C, H, W = clip.shape

        # -------------------------------------------------
        # spatial resize + crop + optional flip
        # -------------------------------------------------
        new_h, new_w, top, left, flip = self._spatial_params(H, W)

        clip = torch.nn.functional.interpolate(
            clip,
            size=(new_h, new_w),
            mode="bilinear",
            align_corners=False
        )

        clip = clip[:, :, top:top+self.frame_size, left:left+self.frame_size]

        if flip:
            clip = clip.flip(-1)

        # -------------------------------------------------
        # normalize
        # -------------------------------------------------
        clip = (clip - self.mean) / self.std

        # final shape: (T, C, H, W)
        return clip, label


# =========================================================
# 5) Main loader builder
# =========================================================
def prepare_ucf101_binary_loaders(
    data_root,
    binary_classes=("Basketball", "Diving"),
    num_frames=16,
    frame_size=96,
    batch_size=4,
    num_workers=2,
    debug=True,
    train_per_class=400,
    val_per_class=80,
    test_per_class=80,
    seed=0
):
    """
    data_root: root folder containing train.csv / val.csv / test.csv and video files
    binary_classes: tuple/list of exactly two classes
    debug=True => subsample per class for faster experiments
    """

    data_root = Path(data_root)

    # -----------------------------------------
    # read csv files
    # -----------------------------------------
    train_df = pd.read_csv(data_root / "train.csv")
    val_df   = pd.read_csv(data_root / "val.csv")
    test_df  = pd.read_csv(data_root / "test.csv")

    path_col, label_col = resolve_columns(train_df)

    # -----------------------------------------
    # keep only 2 classes
    # -----------------------------------------
    train_df, val_df, test_df, class_to_idx, idx_to_class = make_binary_split(
        train_df, val_df, test_df, label_col, list(binary_classes)
    )

    # -----------------------------------------
    # optional debug subsampling
    # -----------------------------------------
    if debug:
        train_df = sample_per_class(train_df, label_col, train_per_class, seed=seed)
        val_df   = sample_per_class(val_df, label_col, val_per_class, seed=seed)
        test_df  = sample_per_class(test_df, label_col, test_per_class, seed=seed)

    print("========== Binary UCF101 ==========")
    print("Classes:", binary_classes)
    print("\nTrain counts:")
    print(train_df[label_col].value_counts())
    print("\nVal counts:")
    print(val_df[label_col].value_counts())
    print("\nTest counts:")
    print(test_df[label_col].value_counts())

    # -----------------------------------------
    # datasets
    # -----------------------------------------
    train_ds = UCF101BinaryVideoDataset(
        train_df,
        root_dir=data_root,
        path_col=path_col,
        label_col=label_col,
        class_to_idx=class_to_idx,
        num_frames=num_frames,
        frame_size=frame_size,
        mode="train"
    )

    val_ds = UCF101BinaryVideoDataset(
        val_df,
        root_dir=data_root,
        path_col=path_col,
        label_col=label_col,
        class_to_idx=class_to_idx,
        num_frames=num_frames,
        frame_size=frame_size,
        mode="val"
    )

    test_ds = UCF101BinaryVideoDataset(
        test_df,
        root_dir=data_root,
        path_col=path_col,
        label_col=label_col,
        class_to_idx=class_to_idx,
        num_frames=num_frames,
        frame_size=frame_size,
        mode="test"
    )

    # -----------------------------------------
    # dataloaders
    # -----------------------------------------
    common = dict(
        num_workers=num_workers,
        pin_memory=True,
        persistent_workers=(num_workers > 0)
    )

    train_loader = DataLoader(
        train_ds,
        batch_size=batch_size,
        shuffle=True,
        drop_last=True,
        **common
    )

    val_loader = DataLoader(
        val_ds,
        batch_size=batch_size,
        shuffle=False,
        **common
    )

    test_loader = DataLoader(
        test_ds,
        batch_size=4,
        shuffle=False,
        num_workers=0,
        pin_memory=False
    )

    return train_loader, val_loader, test_loader, class_to_idx, idx_to_class
    
def show_ucf_clip_sample_with_class(dataset, idx_to_class, sample_idx=0, n_show=6, title_prefix="Sample"):
    clip, label = dataset[sample_idx]

    T = clip.shape[0]
    frame_ids = np.linspace(0, T - 1, n_show).astype(int)

    mean = torch.tensor([0.485, 0.456, 0.406]).view(3, 1, 1)
    std  = torch.tensor([0.229, 0.224, 0.225]).view(3, 1, 1)

    clip_vis = clip * std + mean
    clip_vis = clip_vis.clamp(0, 1)

    fig, axes = plt.subplots(1, len(frame_ids), figsize=(3 * len(frame_ids), 3))
    if len(frame_ids) == 1:
        axes = [axes]

    for ax, t in zip(axes, frame_ids):
        img = clip_vis[t].permute(1, 2, 0).cpu().numpy()
        ax.imshow(img)
        ax.set_title(f"t={t}")
        ax.axis("off")

    class_name = idx_to_class[label]
    plt.suptitle(f"{title_prefix} | label={label} | class={class_name}")
    plt.tight_layout()
    plt.show()


train_video_loader, val_video_loader, test_video_loader, class_to_idx, idx_to_class = prepare_ucf101_binary_loaders(
    data_root=DATA_ROOT,
