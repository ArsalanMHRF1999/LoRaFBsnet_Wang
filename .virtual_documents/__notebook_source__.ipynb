class EvidenceIntegrator:
    def __init__(self, tau=0.85, normalize=True, rate_scale=40):
        self.tau = tau
        self.normalize = normalize
        self.rate_scale = rate_scale

    def extract_population_activity(self, feat_TxC, neuron_ids):
        """
        feat_TxC: (T, C)
        neuron_ids: selected neuron indices for one class
        """
        spikes = feat_TxC[:, neuron_ids]     # (T, n_sel)
        population_rate = spikes.mean(axis=1)  # (T,)
        return population_rate
    
    def temporal_integration(self, evidence):
        integrated = np.zeros_like(evidence)
        integrated[0] = evidence[0]
    
        for t in range(1, len(evidence)):
            integrated[t] = (
                self.tau * integrated[t - 1]
                + (1 - self.tau) * evidence[t]
            )
        return integrated
    
    def normalize_evidence(self, evidence):
        if not self.normalize:
            return evidence
    
        mx = evidence.max()
        if mx > 1e-8:
            evidence = evidence / mx
        return evidence
    
    def build_rate_envelope(self, feat_TxC, neuron_ids):
        evidence = self.extract_population_activity(feat_TxC, neuron_ids)
        evidence = self.temporal_integration(evidence)
        evidence = self.normalize_evidence(evidence)
        return evidence * self.rate_scale





class WangModel:
    def __init__(self, test_X_TCx, sel_lists, params, config):
        self.test_X_TCx = test_X_TCx
        self.sel_lists = sel_lists
        self.n_classes = len(sel_lists)
        self.params = params
        self.config = config

        self.integrator = EvidenceIntegrator(
            tau=self.params.get('tau_integrator', 0.6),
            normalize=False,
            rate_scale=self.params['mu0_target']
        )
    
        self.timed_arrays = self.generate_timed_arrays()

    def resample_env(self, env_in, bins_out):
        """
        env_in: (N, Tin)
        out   : (N, bins_out)
        """
        N, Tin = env_in.shape
        x_old = onp.linspace(0.0, 1.0, Tin, endpoint=False)
        x_new = onp.linspace(0.0, 1.0, bins_out, endpoint=False)
    
        out = onp.empty((N, bins_out), dtype=onp.float64)
        for n in range(N):
            out[n] = onp.interp(x_new, x_old, env_in[n])
    
        return out
    
    @staticmethod
    def build_long_rate(envelopes, n_trials, duration, stim_on, runtime):
        """
        envelopes: (N, T_bins)
        builds a long 1D rate signal for Brian2 TimedArray
        by placing each trial envelope inside its own trial time window.
        """
        steps_per_trial = int(onp.round(runtime / duration))
        total_steps = n_trials * steps_per_trial
        on_idx = int(onp.round(stim_on / duration))
    
        arr = onp.zeros(total_steps, dtype=onp.float64)
        T_bins = envelopes.shape[1]
    
        for tr in range(n_trials):
            start = tr * steps_per_trial + on_idx
            end = start + T_bins
            arr[start:end] = envelopes[tr]
    
        return arr * Hz
    
    def generate_timed_arrays(self):
        timed_arrays = []
        env_per_class = []             # cache to avoid double computation
    
        # Build envelopes for every class × trial
        for c in range(self.n_classes):
            env_class = []
            for trial_idx in range(self.params['n_trials']):
                feat = self.test_X_TCx[trial_idx]   # (T, C)
                env  = self.integrator.build_rate_envelope(feat, self.sel_lists[c])
                env_class.append(env)
            env_per_class.append(onp.array(env_class))   # (N, T_feat)
    
    
        # Build timed arrays
        for c, env_class in enumerate(env_per_class):
            envs = self.resample_env(env_class, self.params['bins_out'])
            level_duration = (
                self.params['stim_off'] - self.params['stim_on']
            ) / envs.shape[1]
    
            vals = self.build_long_rate(
                envs,
                self.params['n_trials'],
                level_duration,
                self.params['stim_on'],
                self.params['runtime']
            )
            timed_arrays.append(TimedArray(vals, dt=level_duration))
    
        return timed_arrays



def trial_mean_rate(monitor, n_trials, stim_on_ms, stim_off_ms, runtime_ms):
    t_ms = monitor.t / ms
    rate_hz = monitor.rate / Hz
    
    means = onp.empty(n_trials)
    for tr in range(n_trials):
        t_start = tr * runtime_ms + stim_on_ms
        t_end   = tr * runtime_ms + stim_off_ms
        mask = (t_ms >= t_start) & (t_ms < t_end)
        means[tr] = rate_hz[mask].mean() if mask.any() else 0.0
    
    return means

def trial_rate_trace(monitor, n_trials, stim_on_ms, stim_off_ms, runtime_ms):
    """Extract full rate trace for each trial during stimulus window.

    Returns:
        traces: list of length n_trials
                traces[tr] = (time_rel_ms, rate_hz)
    """
    t_ms = onp.asarray(monitor.t / ms)
    rate_hz = onp.asarray(monitor.rate / Hz)
    
    traces = []
    
    for tr in range(n_trials):
        t_start = tr * runtime_ms + stim_on_ms
        t_end   = tr * runtime_ms + stim_off_ms
    
        mask = (t_ms >= t_start) & (t_ms < t_end)
    
        t_rel = t_ms[mask] - t_start
        r = rate_hz[mask]
    
        traces.append((t_rel, r))
    
    return traces

def build_trial_rate_matrix(monitor, n_trials, stim_on_ms, stim_off_ms, runtime_ms,smooth_width=10*ms): 
    t_ms = onp.asarray(monitor.t / ms)
    rate_hz = onp.asarray(monitor.rate / Hz)
    
    traces = []
    for tr in range(n_trials):
        t_start = tr * runtime_ms + stim_on_ms
        t_end   = tr * runtime_ms + stim_off_ms
        mask    = (t_ms >= t_start) & (t_ms < t_end)
        traces.append((t_ms[mask] - t_start, rate_hz[mask]))
    
    lengths  = [len(x[1]) for x in traces]
    min_len  = min(lengths)
    rate_mat = onp.stack([r[:min_len] for _, r in traces], axis=0)
    time_axis = traces[0][0][:min_len]
    
    return time_axis, rate_mat

def build_decision_network_2class(timed_arrays, config):
    start_scope()
    
    # --------------------------------------------------------
    # Excitatory neurons
    # --------------------------------------------------------
    eqsE = '''
    dV/dt = (-(V - Vrest_e) + Iext - w*V)/(20*ms) : volt (unless refractory)
    Iext : volt
    Vrest_e : volt
    w : 1
    '''
    
    # --------------------------------------------------------
    # Inhibitory neurons
    # --------------------------------------------------------
    eqsI = '''
    dV/dt = (-(V - Vrest_i) + Iext)/(10*ms) : volt (unless refractory)
    Iext : volt
    Vrest_i : volt
    '''
    
    ng_ns = {
        'Vth': config['Vth'],
        'Vreset': config['Vreset']
    }
    
    # --------------------------------------------------------
    # Decision pools
    # --------------------------------------------------------
    D0 = NeuronGroup(
        config['NE'],
        eqsE,
        threshold='V > Vth',
        reset='V = Vreset',
        refractory=2*ms,
        method='euler',
        namespace=ng_ns
    )
    
    D1 = NeuronGroup(
        config['NE'],
        eqsE,
        threshold='V > Vth',
        reset='V = Vreset',
        refractory=2*ms,
        method='euler',
        namespace=ng_ns
    )
    
    D = [D0, D1]
    
    # --------------------------------------------------------
    # Inhibitory pool
    # --------------------------------------------------------
    I = NeuronGroup(
        config['NI'],
        eqsI,
        threshold='V > Vth',
        reset='V = Vreset',
        refractory=1*ms,
        method='euler',
        namespace=ng_ns
    )
    
    # --------------------------------------------------------
    # Initialization
    # --------------------------------------------------------
    for Di in D:
        Di.V = config['Vrest']
        Di.Vrest_e = config['Vrest']
        Di.Iext = config['Iext']*mV
        Di.w = config['adaptation_weight']
    
    I.V = config['Vrest']
    I.Vrest_i = config['Vrest']
    I.Iext = 0*mV
    
    syns = []
    
    # --------------------------------------------------------
    # recurrent excitation داخل هر pool
    # --------------------------------------------------------
    for Di in D:
        s = Synapses(
            Di, Di,
            on_pre=f'V_post += {config["exc_weight"]}*mV'
        )
        s.connect(p=0.10)
        syns.append(s)
    
    # --------------------------------------------------------
    # Exc -> Inh
    # --------------------------------------------------------
    for Di in D:
        s = Synapses(
            Di, I,
            on_pre='V_post += 1.2*mV'
        )
        s.connect(p=0.30)
        syns.append(s)
    
    # --------------------------------------------------------
    # Inh -> Exc
    # --------------------------------------------------------
    for Di in D:
        s = Synapses(
            I, Di,
            on_pre=f'V_post += {config["inh_weight"]}*mV'
        )
        s.connect(p=0.40)
        syns.append(s)
    
    # --------------------------------------------------------
    # sensory input Poisson groups
    # --------------------------------------------------------
    inputs = []
    
    for i, ta in enumerate(timed_arrays):
        P = PoissonGroup(
            config['NE'],
            rates='ta(t)',
            namespace={'ta': ta}
        )
    
        s = Synapses(
            P, D[i],
            on_pre=f'V_post += {config["input_weight"]}*mV'
        )
        s.connect(p=0.20)
    
        inputs += [P, s]
    
    # --------------------------------------------------------
    # monitors
    # --------------------------------------------------------
    R = [PopulationRateMonitor(Di) for Di in D]
    SM = [SpikeMonitor(Di) for Di in D]
    
    net = Network(D + [I] + syns + inputs + R + SM)
    return net, D, I, R, SM


def decide_trials_with_threshold(
    R,
    n_trials,
    runtime_ms,
    stim_on_ms,
    stim_off_ms,
    decision_threshold_hz=15.0,
    fallback_to_mean=True,
    grace_period_ms=30.0,
    alpha=0.7
):
    """
    Decision:
        First threshold crossing of DV = rate0-rate1

    Reaction Time:
        First threshold crossing time

    Confidence:
        alpha * normalized area after decision
        +
        (1-alpha) * normalized RT
    """

    # ============================================================
    # Mean firing rates
    # ============================================================

    means = onp.stack(
        [
            trial_mean_rate(
                R[i],
                n_trials,
                stim_on_ms,
                stim_off_ms,
                runtime_ms
            )
            for i in range(2)
        ],
        axis=1
    )

    # ============================================================
    # Full traces
    # ============================================================

    time_axis, rate0_mat = build_trial_rate_matrix(
        R[0],
        n_trials,
        stim_on_ms,
        stim_off_ms,
        runtime_ms
    )

    _, rate1_mat = build_trial_rate_matrix(
        R[1],
        n_trials,
        stim_on_ms,
        stim_off_ms,
        runtime_ms
    )

    pred_choice = onp.zeros(n_trials, dtype=int)

    reaction_times = onp.full(
        n_trials,
        onp.nan,
        dtype=float
    )

    confidence = onp.full(
        n_trials,
       onp.nan,
        dtype=float
    )

    decision_source = []

    max_rt = time_axis[-1]

    # ============================================================
    # Trial loop
    # ============================================================

    for tr in range(n_trials):

        dv = rate0_mat[tr] - rate1_mat[tr]

        grace_mask = time_axis >= grace_period_ms

        idx_pos = onp.where(
            (dv >= decision_threshold_hz) &
            grace_mask
        )[0]

        idx_neg = onp.where(
            (dv <= -decision_threshold_hz) &
            grace_mask
        )[0]

        first_pos = idx_pos[0] if len(idx_pos) else None
        first_neg = idx_neg[0] if len(idx_neg) else None

        # ========================================================
        # Threshold reached
        # ========================================================

        if first_pos is not None or first_neg is not None:

            if first_pos is None:

                winner = 1
                cross_idx = first_neg

            elif first_neg is None:

                winner = 0
                cross_idx = first_pos

            else:

                if first_pos < first_neg:

                    winner = 0
                    cross_idx = first_pos

                else:

                    winner = 1
                    cross_idx = first_neg

            pred_choice[tr] = winner

            rt = time_axis[cross_idx]

            reaction_times[tr] = rt

            decision_source.append(
                f"threshold_{winner}"
            )

            # ====================================================
            # Confidence
            # ====================================================

            # Difference after decision

            dv_after = onp.abs(
                dv[cross_idx:]
            )

            t_after = time_axis[cross_idx:]

            if len(dv_after) > 1:

                area = onp.trapezoid(
                    dv_after,
                    t_after
                )

            else:

                area = 0

            duration = (
                stim_off_ms - stim_on_ms
            ) - rt

            if duration <= 0:

                duration = 1e-6

            area_norm = area / duration

            rt_score = 1 - rt / max_rt

            confidence[tr] = (
                alpha * area_norm
                +
                (1-alpha) * rt_score
            )

        # ========================================================
        # No threshold crossing
        # ========================================================

        else:

            if fallback_to_mean:

                pred_choice[tr] = onp.argmax(
                    means[tr]
                )

                decision_source.append(
                    "fallback_mean"
                )

            else:

                pred_choice[tr] = onp.argmax(
                    means[tr]
                )

                decision_source.append(
                    "forced_argmax"
                )

            reaction_times[tr] = onp.nan

            confidence[tr] = 0.0

    # ============================================================
    # Normalize confidence
    # ============================================================

    valid = ~onp.isnan(confidence)

    if onp.any(valid):

        mn = confidence[valid].min()

        mx = confidence[valid].max()

        if mx > mn:

            confidence[valid] = (
                confidence[valid] - mn
            ) / (mx - mn)

        else:

            confidence[valid] = 0.5

    return (
        pred_choice,
        reaction_times,
        confidence,
        decision_source,
        means,
        rate0_mat,
        rate1_mat,
        time_axis
    )


def evaluate_wang_accuracy(wang: WangModel,test_y,plot=False,n_warmup=3):
    runtime_ms  = wang.params['runtime'] / ms
    stim_on_ms  = wang.params['stim_on']  / ms
    stim_off_ms = wang.params['stim_off'] / ms
    n_trials    = wang.params['n_trials']

    # ---------------- build network ----------------
    net, D, I, R, SM = build_decision_network_2class(
        wang.timed_arrays,
        wang.config
    )
    
    # ---------------- run full simulation ----------------
    for tr in range(n_trials):
        
        # 1. Reset Excitatory decision pools (D0, D1)
        for Di in D:
            Di.V = wang.config['Vrest']
            # If your network relies on internal variables or if you implement a dynamic 'w',
            # reset them here. Since 'w' in your current code is static, we leave it, 
            # but we ensure the voltage is completely stabilized.
            
        # 2. Reset Inhibitory pool (I)
        I.V = wang.config['Vrest']
        
        # 3. CRITICAL: Flush hidden variables created by Synapses
        # Brian2 creates internal variables like 'V_post_pre' or path delays 
        # when using pathways. Clearing them prevents cross-trial leakage.
        for obj in net.objects:
            if isinstance(obj, Synapses):
                # This zeroes out any pre-computed or in-flight synaptic increments
                if hasattr(obj, 'clear_pathways'):
                    obj.clear_pathways()
        
        # 4. Run the chunk of time allocated for this specific trial
        net.run(wang.params['runtime'])
    wang.network_confidence = onp.abs(
    trial_mean_rate(R[0], n_trials, stim_on_ms, stim_off_ms, runtime_ms)
    - trial_mean_rate(R[1], n_trials, stim_on_ms, stim_off_ms, runtime_ms))
    # ---------------- threshold-based decision ----------------
    (
        pred_choice,
        reaction_times,
        confidence,
        decision_source,
        means,
        rate0_mat,
        rate1_mat,
        time_axis
    ) = decide_trials_with_threshold(
        R,
        n_trials,
        runtime_ms,
        stim_on_ms,
        stim_off_ms,
        decision_threshold_hz=wang.params["decision_threshold_hz"],
        fallback_to_mean=True
    )
    
    # ---------------- remove warmup trials ----------------
    if n_warmup > 0 and n_warmup < n_trials:
        valid_preds = pred_choice[n_warmup:]
        valid_y = onp.array(test_y)[n_warmup:]
        valid_rt = reaction_times[n_warmup:]
        valid_decision_source = decision_source[n_warmup:]
        valid_conf = confidence[n_warmup:]
    
        valid_means = means[n_warmup:]
        valid_rate0 = rate0_mat[n_warmup:]
        valid_rate1 = rate1_mat[n_warmup:]
    
        print(f"[warmup] excluding first {n_warmup} trials from scoring")
    else:
        valid_preds = pred_choice
        valid_y = onp.array(test_y)
        valid_rt = reaction_times
        valid_decision_source = decision_source
        valid_conf = confidence
    
        valid_means = means
        valid_rate0 = rate0_mat
        valid_rate1 = rate1_mat
    
    acc = onp.mean(valid_preds == valid_y)
    
    n_threshold = onp.sum(onp.array([s.startswith('threshold') for s in valid_decision_source]))
    n_fallback  = onp.sum(onp.array([s == 'fallback_mean' for s in valid_decision_source]))
    
    print(f"Wang SNN accuracy (excluding {n_warmup} warm-up trials): {acc:.3f}")
    print(f"Total trials: {n_trials} | Scored trials: {len(valid_y)}")
    print(f"Class distribution in scored trials: {onp.bincount(valid_y.astype(int))}")
    print(f"Threshold decisions: {n_threshold}")
    print(f"Fallback decisions:  {n_fallback}")
    
    finite_rt = valid_rt[onp.isfinite(valid_rt)]
    if len(finite_rt) > 0:
        print(f"Mean RT = {finite_rt.mean():.2f} ms | Median RT = {onp.median(finite_rt):.2f} ms")
    else:
        print("No finite reaction times (no threshold crossing in scored trials).")
    
    return {
        'acc': acc,
        'pred_choice_all': pred_choice,
        'valid_preds': valid_preds,
        'valid_y': valid_y,
        'valid_rt': valid_rt,
        'valid_decision_source': valid_decision_source,
        'valid_confidences': valid_conf,
        'means_all': means,
        'valid_means': valid_means,
        'valid_rate0': valid_rate0,
        'valid_rate1': valid_rate1,
        'time_axis': time_axis,
        'R': R,
        'SM': SM,
        'runtime_ms': runtime_ms,
        'stim_on_ms': stim_on_ms,
        'stim_off_ms': stim_off_ms
    }

def load_neuron_selection(path):

    d = onp.load(path, allow_pickle=True)
    
    class_keys = sorted([
        k for k in d.files
        if k.startswith('class_')
        and k != 'class_means'
    ])
    
    print("Found classes:", class_keys)
    
    per_class = [
        d[k]
        for k in class_keys
    ]
    
    global_topk = onp.unique(
        onp.concatenate(per_class)
    )
    
    return {
        'global': global_topk,
        'class_means': d['class_means'],
        'per_class': per_class
    }

def load_saved_feature_extractor(model_path,neuron_path,device):

    full_model = load_model_from_state_dict(
        model_path,
        device
    )
    
    extractor = LoRaFBSNetFeatureExtractor(
        full_model
    )
    
    sel = load_neuron_selection(
        neuron_path
    )
    
    return extractor, sel



def plot_wang_results(result_dict,n_warmup=3):
    R = result_dict['R']
    SM = result_dict['SM']
    valid_y = result_dict['valid_y']
    valid_preds = result_dict['valid_preds']
    valid_rt = result_dict['valid_rt']
    valid_conf = result_dict['valid_confidences']
    valid_means = result_dict['valid_means']
    valid_rate0 = result_dict['valid_rate0']
    valid_rate1 = result_dict['valid_rate1']
    time_axis = result_dict['time_axis']

    n_trials_scored = len(valid_y)
    
    colors = ['steelblue', 'tomato']
    
    # decision margin from mean rates
    winner_rate = valid_means.max(axis=1)
    loser_rate  = valid_means.min(axis=1)
    margin = winner_rate - loser_rate
    
    correct = (valid_preds == valid_y)
    
    fig = plt.figure(figsize=(22, 20))
    gs = fig.add_gridspec(5, 3)
    
    # ========================================================
    # 1) Population Rates (whole simulation)
    # ========================================================
    ax = fig.add_subplot(gs[0, 0])
    for i, mon in enumerate(R):
        ax.plot(mon.t/ms, mon.rate/Hz, color=colors[i], label=f'Pool {i}')
    ax.set_title("Population Rates (whole simulation)")
    ax.set_xlabel("Time (ms)")
    ax.set_ylabel("Hz")
    ax.legend()
    
    # ========================================================
    # 2) Spike Raster
    # ========================================================
    ax = fig.add_subplot(gs[0, 1])
    offset = 0
    for i, mon in enumerate(SM):
        ax.scatter(mon.t/ms, mon.i + offset, s=1, alpha=0.5, color=colors[i])
        offset += 350
    ax.set_title("Spike Raster")
    ax.set_xlabel("Time (ms)")
    ax.set_ylabel("Neuron index")
    
    # ========================================================
    # 3) Mean Rate per Trial
    # ========================================================
    ax = fig.add_subplot(gs[0, 2])
    x = onp.arange(n_trials_scored)
    ax.bar(x - 0.2, valid_means[:, 0], width=0.4, label='Pool0')
    ax.bar(x + 0.2, valid_means[:, 1], width=0.4, label='Pool1')
    ax.set_title("Trial Mean Rates")
    ax.set_xlabel("Trial")
    ax.set_ylabel("Hz")
    ax.legend()
    
    # ========================================================
    # 4) Decision Margin
    # ========================================================
    ax = fig.add_subplot(gs[1, 0])
    ax.plot(margin, marker='o', linewidth=1)
    ax.set_title("Decision Margin = winner_rate - loser_rate")
    ax.set_xlabel("Trial")
    ax.set_ylabel("Hz")
    
    # ========================================================
    # 5) Pool0 histogram
    # ========================================================
    ax = fig.add_subplot(gs[1, 1])
    ax.hist(valid_means[:, 0], bins=25)
    ax.set_title("Pool0 Mean Rate Distribution")
    ax.set_xlabel("Hz")
    
    # ========================================================
    # 6) Pool1 histogram
    # ========================================================
    ax = fig.add_subplot(gs[1, 2])
    ax.hist(valid_means[:, 1], bins=25)
    ax.set_title("Pool1 Mean Rate Distribution")
    ax.set_xlabel("Hz")
    
    # ========================================================
    # 7) Confusion Matrix
    # ========================================================
    ax = fig.add_subplot(gs[2, 0])
    cm = confusion_matrix(valid_y, valid_preds)
    im = ax.imshow(cm)
    plt.colorbar(im, ax=ax)
    ax.set_title("Confusion Matrix")
    ax.set_xlabel("Predicted")
    ax.set_ylabel("True")
    for i in range(cm.shape[0]):
        for j in range(cm.shape[1]):
            ax.text(j, i, cm[i, j], ha='center', va='center')
    
    # ========================================================
    # 8) Confidence histogram
    # ========================================================
    ax = fig.add_subplot(gs[2, 1])
    ax.hist(valid_conf, bins=25)
    ax.set_title("Evidence Confidence Distribution")
    ax.set_xlabel("Confidence")
    
    # ========================================================
    # 9) Margin vs correctness
    # ========================================================
    ax = fig.add_subplot(gs[2, 2])
    ax.scatter(onp.arange(len(margin)), margin, c=correct.astype(int))
    ax.set_title("Margin vs Correctness")
    ax.set_xlabel("Trial")
    ax.set_ylabel("Margin")
    
    # ========================================================
    # 10) Reaction Time per trial
    # ========================================================
    ax = fig.add_subplot(gs[3, 0])
    ax.plot(valid_rt, marker='o', linestyle='-')
    ax.set_title("Reaction Time per Trial")
    ax.set_xlabel("Trial")
    ax.set_ylabel("RT (ms)")
    
    # ========================================================
    # 11) Reaction Time histogram
    # ========================================================
    ax = fig.add_subplot(gs[3, 1])
    finite_rt = valid_rt[onp.isfinite(valid_rt)]
    if len(finite_rt) > 0:
        ax.hist(finite_rt, bins=25)
    ax.set_title("Reaction Time Distribution")
    ax.set_xlabel("RT (ms)")
    
    # ========================================================
    # 12) RT vs correctness
    # ========================================================
    ax = fig.add_subplot(gs[3, 2])
    ax.scatter(valid_rt, correct.astype(int))
    ax.set_title("RT vs Correctness")
    ax.set_xlabel("RT (ms)")
    ax.set_ylabel("Correct (1/0)")
    
    # ========================================================
    # 13) RT vs confidence
    # ========================================================
    ax = fig.add_subplot(gs[4, 0])
    
    mask = onp.isfinite(valid_rt)
    
    if onp.any(mask):
        ax.scatter(valid_conf[mask], valid_rt[mask], alpha=0.7, color='purple')
        m, b = onp.polyfit(valid_conf[mask], valid_rt[mask], 1)
        ax.plot(valid_conf[mask], m * valid_conf[mask] + b, color='black', linestyle='--')
        
    ax.set_title("Reaction Time vs Input Confidence")
    ax.set_xlabel("Confidence")
    ax.set_ylabel("RT (ms)")
    
    # ========================================================
    # 14) Mean trial rate traces for correct vs wrong
    # ========================================================
    ax = fig.add_subplot(gs[4, 1])
    
    if onp.any(correct):
        mean_r0_correct = valid_rate0[correct].mean(axis=0)
        mean_r1_correct = valid_rate1[correct].mean(axis=0)
    
        ax.plot(time_axis, mean_r0_correct, label='Pool0 correct', color='steelblue')
        ax.plot(time_axis, mean_r1_correct, label='Pool1 correct', color='tomato')
    
    if onp.any(~correct):
        mean_r0_wrong = valid_rate0[~correct].mean(axis=0)
        mean_r1_wrong = valid_rate1[~correct].mean(axis=0)
    
        ax.plot(time_axis, mean_r0_wrong, '--', label='Pool0 wrong', color='navy')
        ax.plot(time_axis, mean_r1_wrong, '--', label='Pool1 wrong', color='darkred')
    
    ax.set_title("Average Stimulus-Epoch Rate Traces")
    ax.set_xlabel("Time from stimulus onset (ms)")
    ax.set_ylabel("Hz")
    ax.legend()
    
    # ========================================================
    # 15) RT vs margin
    # ========================================================
    ax = fig.add_subplot(gs[4, 2])
    
    if onp.any(mask):
        ax.scatter(margin[mask], valid_rt[mask], alpha=0.7, color='darkgreen')
        # Add a trendline
        m, b = onp.polyfit(margin[mask], valid_rt[mask], 1)
        ax.plot(margin[mask], m * margin[mask] + b, color='black', linestyle='--')
        
    ax.set_title("Reaction Time vs Decision Margin")
    ax.set_xlabel("Margin (Winner Hz - Loser Hz)")
    ax.set_ylabel("RT (ms)")



def main():
    device = 'cuda' if torch.cuda.is_available() else 'cpu'

    # --------------------------------------------------------
    # load feature extractor + neuron selection
    # --------------------------------------------------------
    extractor, sel = load_saved_feature_extractor(
        '/kaggle/working/best_model.pth',
        '/kaggle/working/neuron_selection.npz',
        device
    )
    
    # --------------------------------------------------------
    # extract features from test videos
    # --------------------------------------------------------
    X_test, y_test = extract_features_from_lora_video(
        extractor,
        test_video_loader,
        device=device
    )
    
    print("X_test shape:", X_test.shape)   # (N, T, C)
    print("y_test shape:", y_test.shape)
    
    # --------------------------------------------------------
    # hyperparameter search space
    # --------------------------------------------------------
    search_space = {
        "tau": [0.3,0.5,0.7,0.9],
        "mu": [40,60,80,100],
        "exc": [1.2,1.5,2.0,2.8],
        "inh": [-0.5,-0.7,-0.9,-1.1],
        "input_weight": [0.5,1.0,1.5,2.0],
        "Vth": [-51*mV,-52*mV,-53*mV,-54*mV],
        "bins_out": [10,20,30],
        "adaptation_weight": [0.025,0.05,0.1],
        "Iext": [0.1,0.15,0.2],
        "decision_threshold_hz": [12,16,20,24]
    }
    
    best_acc = 0
    best_params = None
    best_result = None
    
    # --------------------------------------------------------
    # fixed params
    # --------------------------------------------------------
    params = {
        'n_trials': X_test.shape[0],
        'stim_on': 150 * ms,
        'stim_off': 550 * ms,
        'runtime': 700 * ms,
        'Hz': Hz,
        'fallback_to_mean': True,
    }
    
    config = {
        'NE': 300,
        'NI': 180,
        'Vreset': -60*mV,
        'Vrest': -62*mV,
    }
    
    N_SEARCH = 20
    
    for i in range(N_SEARCH):
        print("=" * 80)
        print(f"SEARCH {i+1}/{N_SEARCH}")
    
        tau = choice(search_space["tau"])
        mu = choice(search_space["mu"])
        exc = choice(search_space["exc"])
        inh = choice(search_space["inh"])
        input_weight = choice(search_space["input_weight"])
        Vth = choice(search_space["Vth"])
        bins_out = choice(search_space["bins_out"])
        adaptation_weight = choice(search_space["adaptation_weight"])
        Iext = choice(search_space["Iext"])
        decision_threshold_hz = choice(search_space["decision_threshold_hz"])
    
        # ---- params
        params["mu0_target"] = mu
        params["bins_out"] = bins_out
        params["tau_integrator"] = tau
        params["decision_threshold_hz"] = decision_threshold_hz

        
    
        # ---- config
        config["exc_weight"] = exc
        config["inh_weight"] = inh
        config["input_weight"] = input_weight
        config["Vth"] = Vth
        config["adaptation_weight"] = adaptation_weight
        config["Iext"] = Iext
    
        # ---- build wang
        wang = WangModel(
            X_test,
            sel['per_class'],
            params=params.copy(),
            config=config.copy()
        )
    
        # ---- evaluate
        result = evaluate_wang_accuracy(
            wang,
            y_test,
            plot=False,
            n_warmup=3
        )
    
        acc = result['acc']
    
        print(
            f"tau={tau} | mu={mu} | exc={exc} | inh={inh} | "
            f"input_w={input_weight} | bins_out={bins_out} | "
            f"Vth={Vth} | adapt={adaptation_weight} | Iext={Iext} | "
            f"decision_thr={decision_threshold_hz} | acc={acc:.3f}"
        )
    
        if acc > best_acc:
            best_acc = acc
            best_params = {
                "tau": tau,
                "mu": mu,
                "exc": exc,
                "inh": inh,
                "input_weight": input_weight,
                "bins_out": bins_out,
                "V_threshold": Vth,
                "adaptation_weight": adaptation_weight,
                "Iext": Iext,
                "decision_threshold_hz": decision_threshold_hz
            }
            best_result = result
    
    print("\n" + "="*80)
    print("BEST ACC =", best_acc)
    print("BEST PARAMS =", best_params)
    
    plot_wang_results(best_result, n_warmup=3)


main()


