from sklearn.model_selection import train_test_split
from torch.utils.data import Dataset
from torchvision import transforms
from pathlib import Path
from PIL import Image
import random as pyrandom

class DatasetLoader(Dataset):
    CLASS_NAMES = {
        "with_mask": 0,
        "without_mask": 1
    }

    def __init__(self, rootdir, mode="train", transform="None", test_split=0.15, val_split=0.15, subset_size=1000, seed=42):
        self.transform = transform
        self.mode = mode
        rootDir = Path(rootdir)

        image_paths = []
        labels = []
        cat_images = list((rootDir / "with_mask").glob("*.*"))
        dog_images = list((rootDir / "without_mask").glob("*.*"))

        # remove corrupted files
        cat_images = [p for p in cat_images if p.stat().st_size > 0]
        dog_images = [p for p in dog_images if p.stat().st_size > 0]

        per_class = subset_size // 2
        pyrandom.seed(seed)
        cat_images = pyrandom.sample(
            cat_images,
            min(per_class, len(cat_images))
        )

        dog_images = pyrandom.sample(
            dog_images,
            min(per_class, len(dog_images))
        )
        image_paths.extend(cat_images)
        labels.extend([0] * len(cat_images))

        image_paths.extend(dog_images)
        labels.extend([1] * len(dog_images))
        X_trainval, X_test, y_trainval, y_test = train_test_split(
            image_paths,
            labels,
            test_size=test_split,
            random_state=seed,
            stratify=labels
        )

        val_ratio = val_split / (1 - test_split)

        X_train, X_val, y_train, y_val = train_test_split(
            X_trainval,
            y_trainval,
            test_size=val_ratio,
            random_state=seed,
            stratify=y_trainval
        )
        print(f"Train: {len(X_train)}")
        print(f"Validation: {len(X_val)}")
        print(f"Test: {len(X_test)}")

        if mode == "train":
            self.current_dataset = X_train
            self.current_label = y_train

        elif mode == "validation":
            self.current_dataset = X_val
            self.current_label = y_val

        elif mode == "test":
            self.current_dataset = X_test
            self.current_label = y_test



        

    def __len__(self):
        return len(self.current_dataset)

    def __getitem__(self, idx):
        image = self.current_dataset[idx]
        label = self.current_label[idx]
        img = Image.open(image).convert('RGB')
        if self.transform:
            img = self.transform(img)
        return img, label


def prepareDataLoaders(rootDir, batchSize=32, imageSize=96):

    train_transform = transforms.Compose([
        transforms.Resize((imageSize, imageSize)),
        transforms.RandomHorizontalFlip(p=0.5),
        transforms.RandomRotation(10),
        transforms.ColorJitter(brightness=0.2, contrast=0.2, saturation=0.2),
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406],
                             std=[0.229, 0.224, 0.225])
    ])
    test_eval_transform = transforms.Compose([
        transforms.Resize((imageSize, imageSize)),
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406],
                             std=[0.229, 0.224, 0.225])
    ])
    train_dataset = DatasetLoader(rootdir=rootDir,
                                  mode="train",
                                  transform=train_transform)
    eval_dataset = DatasetLoader(rootdir=rootDir,
                                 mode="validation",
                                 transform=test_eval_transform)
    test_dataset = DatasetLoader(rootdir=rootDir,
                                 mode="test",
                                 transform=test_eval_transform)
    train_loader = torch.utils.data.DataLoader(
        dataset=train_dataset,
        batch_size=batchSize,
        shuffle=True,
        num_workers=2,
        pin_memory=False
    )
    validation_loader = torch.utils.data.DataLoader(
        dataset=eval_dataset,
        batch_size=batchSize,
        shuffle=False,
        num_workers=2,
        pin_memory=False
    )
    test_loader = torch.utils.data.DataLoader(
        dataset=test_dataset,
        batch_size=batchSize,
        shuffle=False,
        num_workers=2,
        pin_memory=False
    )
    return train_loader, validation_loader, test_loader

